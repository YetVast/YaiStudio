# YAI Studio Runtime Environment
# Never commit .env.local

# YAI Application Origin
NEXT_PUBLIC_YAI_ORIGIN=http://localhost:3000

# Yet Vast Auth
YETVAST_AUTH_ORIGIN=https://auth.yetvast.com
YAI_LOGICAL_APP_ID=yai-studio
YAI_AUTH_CALLBACK_URI=http://localhost:3000/api/auth/callback

# Session security (generate with: openssl rand -base64 32)
YAI_SESSION_SECRET=

# GitHub OAuth / App configuration (for storage authorization)
# See docs/auth/AUTHENTICATION_AND_GITHUB_ACCESS.md
YAI_GITHUB_CLIENT_ID=
YAI_GITHUB_CLIENT_SECRET=

# Credential encryption key (generate with: openssl rand -base64 32)
YAI_CREDENTIAL_ENCRYPTION_KEY=

# AI Provider configuration
# Provider keys are stored server-side — never expose to browser
# See docs on approved storage mechanism before configuring
YAI_OPENROUTER_KEY_STORAGE=
YAI_GOOGLE_AI_KEY_STORAGE=

# Vercel KV (if used for provider key storage — decision pending)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Package registry (build-time only — never expose to browser)
# NODE_AUTH_TOKEN=  <-- set in Vercel/CI environment, never here
