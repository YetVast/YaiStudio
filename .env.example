# ═══════════════════════════════════════════════════════════════════════════
# YAI Studio — Vercel Deployment & Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Do NOT commit `.env.local` or plaintext secrets to Git.
# Supply these variables in the Vercel Project Settings > Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Application Origin & Canonical URLs ────────────────────────────────
# In production, set to your canonical custom domain or Vercel production domain.
# On preview branches, YAI Studio automatically resolves from x-forwarded-host if unset.
NEXT_PUBLIC_YAI_ORIGIN=https://yaistudio.yetvast.com
NEXT_PUBLIC_APP_URL=https://yaistudio.yetvast.com

# ── 2. Yet Vast Auth (Central Identity Authority) ─────────────────────────
# Origin of the Yet Vast Auth identity server
YETVAST_AUTH_ORIGIN=https://auth.yetvast.com
YETVAST_AUTH_URL=https://auth.yetvast.com

# Formal logical application ID registered in Yet Vast Auth Admin
YAI_LOGICAL_APP_ID=yai-studio
YETVAST_AUTH_APP_ID=yai-studio

# Exact callback URI registered in Yet Vast Auth Admin for YAI Studio
# Must match: https://<your-domain>/api/auth/callback
YAI_AUTH_CALLBACK_URI=https://yaistudio.yetvast.com/api/auth/callback
YETVAST_AUTH_CALLBACK_URL=https://yaistudio.yetvast.com/api/auth/callback

# ── 3. Host-Bound Session Secret ──────────────────────────────────────────
# HS256 secret for signing the host-bound HTTP-only JWT session cookie (`yai_session`).
# Generate with: openssl rand -base64 32
YAI_SESSION_SECRET=your_32_character_session_signing_secret_here

# ── 4. Server-Side Credential Encryption Key ──────────────────────────────
# 256-bit AES-GCM key used to encrypt GitHub tokens and BYOK AI provider keys at rest.
# Generate with: openssl rand -base64 32
YAI_CREDENTIAL_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here
CREDENTIAL_ENCRYPTION_SECRET=your_32_byte_base64_encryption_key_here

# ── 5. GitHub Storage Authorization (OAuth App) ───────────────────────────
# GitHub OAuth App credentials with `repo` scope for private storage repository CRUD.
# Register at: https://github.com/settings/developers
# Set Authorization callback URL to: https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
YAI_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
YAI_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── 6. Persistent Serverless KV (Vercel KV / Upstash Redis REST) ──────────
# Provides persistent, multi-instance credential storage across Vercel serverless functions.
# Automatically set when adding the Vercel KV or Upstash Redis integration in Vercel.
# If not configured, YAI Studio automatically falls back to an encrypted host-bound session cookie (`yai_vault`).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 7. Build-Time Package Registry Token ──────────────────────────────────
# Required in CI/CD and Vercel build environment ONLY to install private `@yetvast/*` packages
# from GitHub Packages (https://npm.pkg.github.com).
# Must have `read:packages` scope. Never exposed to browser or runtime bundles.
NODE_AUTH_TOKEN=your_github_packages_read_token_here
